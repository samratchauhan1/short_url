<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
        }
    </style>
</head>
<body>
   <h1> URLSHORTNER </h1>
   <!--backend se jo data aa rha hai vo locals ke andr hota hai-->
   <% if (locals.id) { %> 
    <p>url generated: http://localhost:8001/url/<%= id %></p>
   <% }  %>
     
   <div>
   <form method="POST" action="/url">
    <label>
        Enter your original URL:
        <input type="text" name="url" placeholder="https://example.com" required />
    </label>
    <button type="submit">Generate</button>
   </form>
   </div>

   <div>
    <% if (locals.urls) { %>
        <table>
            <thead>
                <tr>
                    <th>S.No</th>
                    <th>Short ID</th>
                    <th>Original / Redirect URL</th>
                    <th>Clicks</th>
                </tr>
            </thead>
            <tbody>
                <% urls.forEach((url, index) => { %>
                    <tr>
                    <td><%= index + 1 %></td>
                    <td><a href="/url/<%= url.shortid %>" target="_blank"><%= url.shortid %></a></td>
                    <td><%= url.redirectURL %></td>
                    <td><%= url.visitHistory ? url.visitHistory.length : 0 %></td>
                    </tr>
             <% }) %>
            </tbody>
        </table>
   <% } %> 
   </div>
</body>
</html>
<!--name="redirectURL"  this name is important kyu ki yhi hamare backend me pass hone wala hai-->